# ---- Model ----
# Real Hugging Face repo IDs only (vLLM does not use Ollama-style "name:tag" ids).
# Default here is sized for a single ~45GB GPU (e.g. a partitioned B200) - see
# README.md for the full sizing table and fallback options.
MODEL_NAME=Qwen/Qwen3-32B
TOKENIZER_NAME=
# fp8 = vLLM quantizes the bf16 checkpoint on load (needs Ada/Hopper/Blackwell
# hardware FP8 support). Leave blank to fall back to full bf16 (needs a smaller
# model - see README).
QUANTIZATION=fp8
DTYPE=auto
TRUST_REMOTE_CODE=true
# Qwen3 has a built-in reasoning/"thinking" mode. Set to false for faster,
# non-reasoning-trace answers.
ENABLE_THINKING=true

# ---- vLLM engine ----
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=8192

# ---- Server ----
HOST=0.0.0.0
PORT=8000
DEFAULT_MAX_TOKENS=1024
DEFAULT_TEMPERATURE=0.7

# Required in production once exposed via Cloudflare - clients must send:
#   Authorization: Bearer <API_KEY>
API_KEY=change-me-to-a-long-random-string
