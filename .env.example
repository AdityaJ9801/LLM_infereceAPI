# ---- Model ----
# Real Hugging Face repo IDs only (not Ollama-style "name:tag" ids).
# Default fits comfortably in ~45GB VRAM at plain bf16, no quantization.
MODEL_NAME=Qwen/Qwen3-14B
TOKENIZER_NAME=
TRUST_REMOTE_CODE=true
# Qwen3 has a built-in reasoning/"thinking" mode. Set to false for faster,
# non-reasoning-trace answers.
ENABLE_THINKING=true

# ---- Inference engine (plain transformers) ----
# "bfloat16", "float16", or "auto" (use the checkpoint's declared dtype).
TORCH_DTYPE=bfloat16
DEVICE=cuda:0
# Opt-in 4-bit (bitsandbytes) quantization - needed to fit a bigger model
# (e.g. Qwen/Qwen3-32B) in ~45GB. Leave false for the simplest/safest path.
LOAD_IN_4BIT=false
# "eager" avoids cuDNN's SDPA backend, which has known bugs on Blackwell
# (B200) GPUs. Try "sdpa" for more speed once things are stable.
ATTN_IMPLEMENTATION=eager

# ---- Concurrency & queueing ----
# Each concurrent generation holds its own KV cache in VRAM - raise this only
# as far as your headroom allows (see README). Requests beyond this limit
# wait in a queue; beyond MAX_QUEUE_SIZE waiting, new requests get HTTP 503.
MAX_CONCURRENT_REQUESTS=2
MAX_QUEUE_SIZE=20

# ---- Idle VRAM release ----
# If nothing runs for this many seconds, the model is unloaded from VRAM
# (freeing it for other processes on a shared server) and transparently
# reloaded on the next request (that next request will be slow - a full
# model load). 0 disables idle unload.
IDLE_UNLOAD_SECONDS=600
IDLE_CHECK_INTERVAL_SECONDS=60

# ---- Server ----
HOST=0.0.0.0
PORT=8000
DEFAULT_MAX_TOKENS=1024
DEFAULT_TEMPERATURE=0.7

# Required in production once exposed via Cloudflare - clients must send:
#   Authorization: Bearer <API_KEY>
API_KEY=apikeyy
